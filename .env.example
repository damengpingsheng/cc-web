# Web 登录密码（可选，不设则首次启动自动生成随机密码）
# CC_WEB_PASSWORD=your-password-here

# 服务监听端口（默认 8002）
PORT=8002

# 服务监听地址（默认 127.0.0.1，仅本机可访问）
# 设为局域网 IP 可供内网其他设备访问，例如 HOST=192.168.1.100
# 设为 0.0.0.0 则监听所有网卡（含 docker 网桥，通常不推荐）
# 注意：绑定到非回环地址会将服务暴露到网络，请确保已设置强密码
HOST=127.0.0.1

# 登录失败封禁白名单（可选，逗号或空格分隔）
# 白名单内的 IP 永不被封禁，适合自己的固定设备
# CC_WEB_IP_WHITELIST=

# Claude CLI 路径（默认在 PATH 中查找 claude）
CLAUDE_PATH=claude

# Codex CLI 路径（默认在 PATH 中查找 codex）
CODEX_PATH=codex

# PushPlus Token（可选，首次启动会自动迁移到 config/notify.json）
PUSHPLUS_TOKEN=
